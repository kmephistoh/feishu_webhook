[Unit]
Description=TrapFall to Feishu Webhook Adapter
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment="LISTEN=127.0.0.1:3000"
Environment="FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/76bf5d4c-753a-4bbf-bebb-40f9aeb1f576"
WorkingDirectory=/opt/feishu-webhook
ExecStart=/usr/local/bin/feishu_webhook
Restart=on-failure
RestartSec=5
Environment="PORT=3000"
Environment="RUST_LOG=info"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feishu-webhook

[Install]
WantedBy=multi-user.target